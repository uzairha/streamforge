# Copy to .env and adjust. Every service reads only the keys it needs.

# --- Common ---
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# --- Kafka / Redpanda ---
KAFKA_BROKERS=localhost:19092
TOPIC_RAW=raw-events
TOPIC_NORMALIZED=normalized-events
TOPIC_AGGREGATES=aggregates
# CONSUMER_GROUP defaults to "streamforge-<service>"

# --- Event source (ingester) ---
SOURCE=synthetic
SYNTHETIC_RATE=25
SYNTHETIC_CHAINS=synthetic
# Keyless public endpoint used when SOURCE=ethereum
ETH_WS_URL=wss://ethereum.publicnode.com
# Ceiling for reconnect backoff (exponential + full jitter) after a dropped
# connection.
ETH_MAX_BACKOFF=30s
# Fetch each block's body and emit one event per transaction, not just a
# block-level event. Doubles RPC calls against the public endpoint.
ETH_FETCH_BODIES=true
# Recent event IDs retained to suppress duplicate deliveries (resubscribe
# replay, endpoint hiccups).
ETH_DEDUP_WINDOW=8192

# --- Aggregator ---
WINDOW_SIZE=1m

# --- Store (aggregator, api) ---
POSTGRES_DSN=postgres://streamforge:streamforge@localhost:5432/streamforge?sslmode=disable

# --- API ---
GRPC_ADDR=:9090
HTTP_ADDR=:8080
API_KEY=

# --- Telemetry ---
METRICS_ADDR=:2112
# OTLP/gRPC collector. The compose stack runs Jaeger with OTLP enabled here.
OTLP_ENDPOINT=localhost:4317
TRACING_ENABLED=false
# Fraction of traces sampled at the root, applied under a parent-based
# sampler: only the service that starts a trace decides, and the rest of the
# pipeline inherits that decision, so a trace is never half-recorded.
# 1.0 is fine for a demo; drop it well below that for load testing or
# Jaeger's in-memory store will not keep up.
TRACE_SAMPLE_RATIO=1.0

# --- Kafka client tuning (M6) ---
# How long the producer waits to accumulate records before sending.
# This helps the ingester, which produces asynchronously and genuinely
# batches, but costs the aggregator dearly — it uses ProduceSync, so one record
# is one batch and the wait is pure added latency (6.8x normalizer throughput
# between 5ms and 0s back when the normalizer did the same; see
# docs/PERFORMANCE.md). The normalizer now batches a whole fetch and is
# insensitive to linger at the rates measured.
# So each stage has its own default: ingester 5ms, normalizer and aggregator 0s.
# Override one stage with <SERVICE>_PRODUCER_LINGER, or every stage at once
# with PRODUCER_LINGER (a stage-specific value still wins over the global one).
#INGESTER_PRODUCER_LINGER=5ms
#NORMALIZER_PRODUCER_LINGER=0s
#AGGREGATOR_PRODUCER_LINGER=0s
#PRODUCER_LINGER=
PRODUCER_MAX_BATCH_BYTES=1000012
# none | gzip | snappy | lz4 | zstd. Compression shrinks large batches; on the
# synchronous single-record path it measured 31% SLOWER.
PRODUCER_COMPRESSION=none

FETCH_MAX_BYTES=52428800
FETCH_MAX_WAIT=5s
FETCH_MIN_BYTES=1
